{
  "name": "madifa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "npm run download-world-topology && tsc -b && vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "start": "npm run build && npm run preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "download-world-topology": "node scripts/download-world-topology.js",
    "seed": "node --loader ts-node/esm scripts/seed.ts",
    "check-schema": "node --loader ts-node/esm scripts/check-schema.ts",
    "migrate": "node --loader ts-node/esm scripts/migrate.ts",
    "manage-users": "node --loader ts-node/esm scripts/manage-users.ts"
  },
