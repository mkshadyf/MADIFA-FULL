    "@types/hpp": "^0.2.6",
    "@types/topojson-specification": "^1.0.5",
    "@types/ua-parser-js": "^0.7.39",
    "@vimeo/player": "^2.20.1",
    "@vimeo/vimeo": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "express-rate-limit": "^7.4.1",
    "framer-motion": "^10.16.4",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "postgres": "^3.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.14.1",
