#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${YELLOW}🔍 Running pre-commit checks...${NC}"

# Function to handle errors
handle_error() {
  echo "${RED}❌ $1 failed${NC}"
  exit 1
}

# Run TypeScript type checking
echo "${YELLOW}Running TypeScript checks...${NC}"
pnpm run type-check || handle_error "TypeScript check"

# Run tests
echo "${YELLOW}Running tests...${NC}"
pnpm run test || handle_error "Tests"

# Run import sorting
echo "${YELLOW}Running import sorting...${NC}"
pnpm run lint:imports || handle_error "Import sorting"

echo "${GREEN}✅ All pre-commit checks passed!${NC}"
