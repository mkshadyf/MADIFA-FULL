{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.mts",
    "src/**/*.mjs",
    "src/lib/**/*.ts",
    "src/middleware/**/*.ts",
    ".eslintrc.cjs",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals", "vite/client", "node"]
  }
} 